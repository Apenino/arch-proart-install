# Copie ce fichier en config.env et adapte-le. config.env est ignoré par git (jamais commité).
# Tout est optionnel : une valeur vide = comportement par défaut ou étape ignorée.

# Nom d'hôte de la machine (vide = inchangé)
HOSTNAME_NEW=""

# Sous-réseau autorisé à joindre SSH, ex. "192.168.1.0/24" (vide = détecté automatiquement)
LAN_CIDR=""

# Importe les clés publiques SSH de ce compte GitHub dans ~/.ssh/authorized_keys (vide = rien)
SSH_GITHUB_USER=""

# "yes" = coupe l'authentification SSH par mot de passe (clé obligatoire).
# Ne le mets à "yes" qu'après avoir vérifié que ta clé fonctionne, sinon tu te bloques l'accès SSH.
SSH_DISABLE_PASSWORD="no"

# IP à ne jamais bannir par fail2ban, séparées par des espaces (ex. ton autre machine)
FAIL2BAN_IGNORE=""

# Profil AppArmor de sshd : "complain" (journalise seulement) ou "enforce" (bloque).
# Passe à "enforce" une fois que tu as vérifié une connexion SSH.
APPARMOR_MODE="complain"

# Démarrage silencieux avec logo (Plymouth) et menu du bootloader masqué (maintenir une touche pour l'afficher)
BOOT_SPLASH="yes"

# Thème Plymouth : "arch-logo" (logo Arch sur fond noir, fourni par le dépôt) ou "keep" pour garder le thème actuel
# (sous CachyOS, l'installeur pose déjà son propre thème).
PLYMOUTH_THEME="arch-logo"
BOOT_HIDE_MENU="yes"

# Retire les paquets inutiles installés avec Lucid (kdeconnect, sshfs...) de façon sûre
PRUNE="yes"

# Disposition de clavier pour Hyprland (vide = reprise de celle du système, ex. "fr")
KB_LAYOUT=""

# Lucid épinglé sur un COMMIT précis (v1.20.1 + correctif de capture d'écran, relu). On épingle le hash et non
# le nom du tag : l'auteur de Lucid a déplacé le tag v1.20.1 après coup. Le commit est vérifié après le clonage.
LUCID_REF="3d6ed3b84edf7c31d24117eb58ed86cb357113c5"
LUCID_COMMIT="3d6ed3b84edf7c31d24117eb58ed86cb357113c5"

# Paquets supplémentaires des dépôts, séparés par des espaces (ex. "solaar" pour du matériel Logitech)
EXTRA_PACKAGES=""

# "no" = installe les paquets AUR sans afficher leur PKGBUILD (utile pour un lancement non interactif).
# Garde "yes" par défaut : relire un PKGBUILD avant de le compiler est la vraie protection de l'AUR.
AUR_REVIEW="yes"
